# ============================================================================
# BASIC SECURITY CONFIGURATION
# ============================================================================

# Disable directory listing - no one can see folder contents
Options -Indexes

# Custom error messages
ErrorDocument 403 /error403.php
ErrorDocument 404 /error404.php
ErrorDocument 500 /error500.php

# PHP upload limits for settlement proofs and similar attachments
php_value upload_max_filesize 20M
php_value post_max_size 24M
php_value memory_limit 256M
php_value max_file_uploads 20

# ============================================================================
# MAINTENANCE MODE REDIRECT
# ============================================================================

# Redirect root index.php to maintenance mode
#RewriteEngine On
#RewriteCond %{REQUEST_URI} ^/index\.php$ [OR]
#RewriteCond %{REQUEST_URI} ^/$
#RewriteRule ^(.*)$ /maintenance/index.php [L,R=302]

