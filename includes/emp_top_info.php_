<script>
$(document).ready(function() {
	// MORE ACTIONS BUTTON - SWEETALERT2 MODAL
	<?php if($emprow["status"] == 1): ?>
	var moreActionsHtml = <?= json_encode($moreActionsHtml) ?>;
	
	$('#moreActionsBtn').click(function() {
		Swal.fire({
			title: '<?= __('more_actions') ?>',
			html: moreActionsHtml,
			showConfirmButton: false,
			showCloseButton: true,
			customClass: {
				container: 'more-actions-modal',
				popup: 'more-actions-popup',
				closeButton: 'more-actions-close'
			},
			width: '400px',
			padding: '0',
			didOpen: function() {
				// Reinitialize event handlers for modal content
				
				// Add Documents
				$('.addEmpDocuAtter').off('click').on('click', function() {
					var eid = $(this).data('id');
					var emp_id = $(this).data('emp_id');
					Swal.close();
					// Trigger existing addEmpDocuAtter handler
					$(document).find('.addEmpDocuAtter[data-id="' + eid + '"]').first().trigger('click');
				});

				// Apply Loan
				$('.applyLoan').off('click').on('click', function() {
					var emp_id = $(this).data('emp_id');
					Swal.close();
					$(document).find('.applyLoan[data-emp_id="' + emp_id + '"]').first().trigger('click');
				});

				// Apply Vacation
				$('.applyvacationAtter').off('click').on('click', function() {
					var empid = $(this).data('empid');
					var dept = $(this).data('dept');
					var country = $(this).data('country');
					var balance = $(this).data('balance');
					Swal.close();
					$(document).find('.applyvacationAtter[data-empid="' + empid + '"]').first().trigger('click');
				});

				// Apply Leave Request
				$('.applyLeaveRequest').off('click').on('click', function() {
					var empid = $(this).data('empid');
					Swal.close();
					$(document).find('.applyLeaveRequest[data-empid="' + empid + '"]').first().trigger('click');
				});

				// Create User Login
				$('.createUserDeptAjax').off('click').on('click', function() {
					var emp_id = $(this).data('emp_id');
					Swal.close();
					$(document).find('.createUserDeptAjax[data-emp_id="' + emp_id + '"]').first().trigger('click');
				});

				// Add Note
				$('.addnote').off('click').on('click', function() {
					var emp_id = $(this).data('emp_id');
					Swal.close();
					$(document).find('.addnote[data-emp_id="' + emp_id + '"]').first().trigger('click');
				});
			}
		});
	});
	<?php endif; ?>
});
</script>